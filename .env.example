# 데이터 소스 선택: mock(기본) | supabase
NEXT_PUBLIC_DATA_SOURCE=mock

# NEXT_PUBLIC_DATA_SOURCE=supabase 일 때만 필요
# Supabase 프로젝트 Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 2-1 PoC: 실거래 기반 가격을 화면에 표시(개발용). 1이면 적용
NEXT_PUBLIC_POC_REAL_PRICES=0

# 국토부 실거래가 라이브 조회용(서버 전용, data.go.kr 발급). 수집 시에만 필요
MOLIT_SERVICE_KEY=

# 수집 잡(pnpm ingest:prices --write)이 Supabase에 쓸 때만 필요(서버 전용).
# 읽기용 anon 키(위)와 분리 — service role은 RLS를 우회하므로 절대 클라이언트 노출 금지.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
